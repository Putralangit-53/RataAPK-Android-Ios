<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rata_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:src="@drawable/brand_logo"
            android:contentDescription="@string/app_name"
            android:adjustViewBounds="true" />

        <TextView
            android:id="@+id/tvPinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/rata_text_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="@string/pin_subtitle"
            android:textSize="14sp"
            android:textColor="@color/rata_text_dark" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pin_hint"
            android:inputType="numberPassword"
            android:maxLength="8"
            android:gravity="center"
            android:textSize="22sp"
            android:letterSpacing="0.3"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <TextView
            android:id="@+id/tvPinError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/rata_error"
            android:visibility="invisible"
            android:text="@string/pin_salah" />

        <Button
            android:id="@+id/btnMasuk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pin_masuk"
            android:backgroundTint="@color/rata_primary"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvHubungiAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pin_hubungi_admin"
            android:textColor="@color/rata_primary"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvNomorAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_nomor_admin"
            android:textColor="@color/rata_text_dark"
            android:textSize="12.5sp"
            android:alpha="0.7" />

    </LinearLayout>

    <!-- Footer, menempel di bawah layar pada semua ukuran layar -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:text="@string/app_footer"
        android:textColor="@color/rata_text_dark"
        android:textSize="11sp"
        android:alpha="0.55"
        android:gravity="center" />

</RelativeLayout>
